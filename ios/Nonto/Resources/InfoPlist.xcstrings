{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "南图"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "南圖"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NonTo"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你点击拍照时使用相机，拍摄的照片由你预览并确认后发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在你點擊拍照時使用相機，拍攝的照片由你預覽並確認後傳送。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NonTo uses the camera only when you choose to take a photo. You can preview and confirm the photo before sending."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你点击保存图片时，将所选图片添加到相册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在你點擊保存圖片時，將所選圖片添加到相簿。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NonTo adds only the selected image to your photo library when you choose Save Image."
          }
        }
      }
    }
  },
  "version": "1.0"
}
