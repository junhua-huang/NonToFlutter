        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我已與監護人共同閱讀這些說明，並獲得監護人同意"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have read this information with my guardian and have their consent"
          }
        },
        "fr": {
