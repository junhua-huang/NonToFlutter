    "请简要说明，勿填写密码、身份证号码等无关敏感信息。": {
      "comment": "ProfileViews.swift:345",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请简要说明，勿填写密码、身份证号码等无关敏感信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請簡要說明，勿填寫密碼、身份證號碼等無關敏感資訊。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefly describe the issue. Do not include passwords, identity document numbers or unrelated sensitive information."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez brièvement le problème. N'incluez pas de mots de passe, de numéros de pièces d'identité ou d'informations sensibles sans rapport."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кратко опишите проблему. Не указывайте пароли, номера документов, удостоверяющих личность, или постороннюю конфиденциальную информацию."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe brevemente el problema. No incluya contraseñas, números de documentos de identidad o información sensible no relacionada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題を簡単に説明します。パスワード、身分証明書番号、または無関係な機密情報は含めないでください。"
          }
        }
      }
    },
