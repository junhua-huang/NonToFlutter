    "请描述遇到的问题、出现步骤和期望结果。截图可在邮件中自行添加。": {
      "comment": "Compliance.swift:28",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请描述遇到的问题、出现步骤和期望结果。截图可在邮件中自行添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請描述遇到的問題、出現步驟和期望結果。截圖可在郵件中自行添加。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the problem, steps to reproduce it and the result you expected. You can add screenshots to your email."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez le problème, les étapes pour le reproduire et le résultat que vous attendiez. Vous pouvez ajouter des captures d'écran à votre e-mail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите проблему, шаги по ее воспроизведению и ожидаемый результат. Вы можете добавить скриншоты в свое письмо."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe el problema, los pasos para reproducirlo y el resultado que esperabas. Puede agregar capturas de pantalla a su correo electrónico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題、それを再現する手順、および期待した結果について説明します。スクリーンショットをメールに追加できます。"
          }
        }
      }
    },
    "请提供内容链接或编号、涉及账号、发生时间及必要依据。侵权投诉请说明权利归属。": {
      "comment": "Compliance.swift:29",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请提供内容链接或编号、涉及账号、发生时间及必要依据。侵权投诉请说明权利归属。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請提供內容連結或編號、涉及帳號、發生時間及必要依據。侵權投訴請說明權利歸屬。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provide the content link or ID, accounts involved, time and supporting evidence. For infringement complaints, explain your ownership of the rights."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournissez le lien ou l'identifiant du contenu, les comptes impliqués, l'heure et les preuves à l'appui. Pour les plaintes pour violation, expliquez votre propriété des droits."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите ссылку на контент или идентификатор, задействованные учетные записи, время и подтверждающие доказательства. В случае жалоб о нарушении прав объясните, что вы владеете правами."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proporcione el enlace o identificación del contenido, las cuentas involucradas, el tiempo y la evidencia de respaldo. Para quejas por infracción, explique su titularidad de los derechos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツのリンクまたは ID、関連するアカウント、時間、および裏付けとなる証拠を提供します。侵害に関する申し立ての場合は、権利の所有権を説明してください。"
          }
        }
      }
    },
    "请说明查阅、复制、更正、删除或撤回等具体请求、账号标识及数据范围。": {
      "comment": "Compliance.swift:30",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请说明查阅、复制、更正、删除或撤回等具体请求、账号标识及数据范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請說明查閱、複製、更正、刪除或撤回等具體請求、帳號標識及數據範圍。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe your request to access, copy, correct, delete or withdraw consent, along with your account identifier and the data concerned."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez votre demande d'accès, de copie, de rectification, de suppression ou de retrait de consentement, ainsi que votre identifiant de compte et les données concernées."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите свой запрос на доступ, копирование, исправление, удаление или отзыв согласия, а также идентификатор вашей учетной записи и соответствующие данные."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describa su solicitud para acceder, copiar, corregir, eliminar o retirar el consentimiento, junto con su identificador de cuenta y los datos en cuestión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント識別子および関連データとともに、アクセス、コピー、修正、削除、または同意の撤回のリクエストについて説明します。"
          }
        }
      }
    },
    "请提供举报或处置编号、收到的处理结果，以及希望复核的事实和理由。": {
      "comment": "Compliance.swift:31",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请提供举报或处置编号、收到的处理结果，以及希望复核的事实和理由。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請提供舉報或處置編號、收到的處理結果，以及希望復核的事實和理由。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provide the report or decision ID, the outcome you received, and the facts and reasons you would like reviewed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fournissez l'identifiant du rapport ou de la décision, le résultat que vous avez reçu ainsi que les faits et les raisons que vous souhaitez examiner."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите идентификатор отчета или решения, полученный вами результат, а также факты и причины, которые вы хотели бы рассмотреть."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proporcione el informe o ID de la decisión, el resultado que recibió y los hechos y motivos que le gustaría revisar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レポートまたは決定 ID、受け取った結果、確認したい事実と理由を提供します。"
          }
        }
      }
    },
    "南图 · %@\n\n%@\n\n%@\n\n请勿发送密码、验证码、无关完整证件或他人的敏感信息。": {
      "comment": "Compliance.swift:35 Format arguments retain their types and order; %@ is text, %lld is an integer. Literal %% is a percent sign.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "南图 · %@\n\n%@\n\n%@\n\n请勿发送密码、验证码、无关完整证件或他人的敏感信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "南圖 · %@\n\n%@\n\n%@\n\n請勿傳送密碼、驗證碼、無關完整證件或他人的敏感資訊。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NonTo · %@\n\n%@\n\n%@\n\nDo not send passwords, verification codes, unrelated full identity documents or other people’s sensitive information."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NonTo · %@\n\n%@\n\n%@\n\nN'envoyez pas de mots de passe, de codes de vérification, de documents d'identité complets sans rapport ou d'informations sensibles d'autres personnes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NonTo · %@\n\n%@\n\n%@\n\nНе отправляйте пароли, коды подтверждения, несвязанные полные документы, удостоверяющие личность, или конфиденциальную информацию других людей."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NonTo · %@\n\n%@\n\n%@\n\nNo envíe contraseñas, códigos de verificación, documentos de identidad completos no relacionados ni información sensible de otras personas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NonTo · %@\n\n%@\n\n%@\n\nパスワード、確認コード、無関係な完全な身分証明書、または他人の機密情報を送信しないでください。"
          }
        }
      }
    },
