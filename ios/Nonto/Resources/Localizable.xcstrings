    "无法读取这张图片，请选择不超过 20 MB 的图片。": {
      "comment": "ChatSticker.swift:25",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取这张图片，请选择不超过 20 MB 的图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取這張圖片，請選擇不超過 20 MB 的圖片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to read this image. Choose an image no larger than 20 MB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire cette image. Choisissez une image ne dépassant pas 20 Mo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно прочитать это изображение. Выберите изображение размером не более 20 МБ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer esta imagen. Elija una imagen que no supere los 20 MB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像を読み取れません。 20 MB 以下の画像を選択してください。"
          }
        }
      }
    },
    "这张图片的链接不可用，请重新添加。": {
      "comment": "ChatSticker.swift:26",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张图片的链接不可用，请重新添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這張圖片的連結不可用，請重新添加。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image link is unavailable. Add it again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien d'image n'est pas disponible. Ajoutez-le à nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка на изображение недоступна. Добавьте его еще раз."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace de esta imagen no está disponible. Agréguelo nuevamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像リンクは利用できません。もう一度追加してください。"
          }
        }
      }
    },
    "请登录后添加贴纸。": {
      "comment": "ChatSticker.swift:27",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请登录后添加贴纸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請登錄後添加貼圖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to add stickers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour ajouter des autocollants."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите, чтобы добавить стикеры."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para agregar pegatinas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステッカーを追加するにはサインインしてください。"
          }
        }
      }
    },
    "最多保存 120 张贴纸，请先删除不需要的贴纸。": {
      "comment": "ChatSticker.swift:28",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多保存 120 张贴纸，请先删除不需要的贴纸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多保存 120 張貼圖，請先刪除不需要的貼圖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can save up to 120 stickers. Delete some to make room."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez enregistrer jusqu'à 120 autocollants. Supprimez-en quelques-uns pour faire de la place."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете сохранить до 120 стикеров. Удалите некоторые, чтобы освободить место."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes guardar hasta 120 stickers. Elimina algunos para hacer espacio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタンプは最大120枚まで保存できます。スペースを空けるために一部を削除します。"
          }
        }
      }
    },
    "贴纸保存失败，请重试。": {
      "comment": "ChatSticker.swift:29",
