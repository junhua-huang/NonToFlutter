          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les publications, commentaires, messages privés, messages de la communauté, termes de recherche et interactions sont utilisés pour la publication, la communication, la recherche, les recommandations et le décompte des non lus."
