          }
        }
      }
    },
    "私信由服务器处理，当前不提供端到端加密。请勿发送密码、验证码或无关证件。": {
      "comment": "PrivacyViews.swift:68",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私信由服务器处理，当前不提供端到端加密。请勿发送密码、验证码或无关证件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私信由伺服器處理，當前不提供端到端加密。請勿傳送密碼、驗證碼或無關證件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private messages are processed by the server and are not currently end-to-end encrypted. Do not send passwords, verification codes or unrelated identity documents."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages privés sont traités par le serveur et ne sont actuellement pas chiffrés de bout en bout. N'envoyez pas de mots de passe, de codes de vérification ou de documents d'identité sans rapport."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Личные сообщения обрабатываются сервером и в настоящее время не подвергаются сквозному шифрованию. Не отправляйте пароли, коды подтверждения или посторонние документы, удостоверяющие личность."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes privados son procesados ​​por el servidor y actualmente no están cifrados de extremo a extremo. No envíe contraseñas, códigos de verificación o documentos de identidad no relacionados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベート メッセージはサーバーによって処理され、現在エンドツーエンドで暗号化されていません。パスワード、確認コード、または無関係な身分証明書を送信しないでください。"
          }
        }
      }
    },
    "照片、视频与通知": {
      "comment": "PrivacyViews.swift:71",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
