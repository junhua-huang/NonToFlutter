    "请描述遇到的问题、出现步骤和期望结果。截图可在邮件中自行添加。": {
      "comment": "Compliance.swift:28",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请描述遇到的问题、出现步骤和期望结果。截图可在邮件中自行添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請描述遇到的問題、出現步驟和期望結果。截圖可在郵件中自行添加。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the problem, steps to reproduce it and the result you expected. You can add screenshots to your email."
          }
        }
      }
    },
    "请提供内容链接或编号、涉及账号、发生时间及必要依据。侵权投诉请说明权利归属。": {
      "comment": "Compliance.swift:29",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请提供内容链接或编号、涉及账号、发生时间及必要依据。侵权投诉请说明权利归属。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請提供內容連結或編號、涉及帳號、發生時間及必要依據。侵權投訴請說明權利歸屬。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provide the content link or ID, accounts involved, time and supporting evidence. For infringement complaints, explain your ownership of the rights."
          }
        }
      }
    },
    "请说明查阅、复制、更正、删除或撤回等具体请求、账号标识及数据范围。": {
      "comment": "Compliance.swift:30",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请说明查阅、复制、更正、删除或撤回等具体请求、账号标识及数据范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請說明查閱、複製、更正、刪除或撤回等具體請求、帳號標識及數據範圍。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe your request to access, copy, correct, delete or withdraw consent, along with your account identifier and the data concerned."
          }
        }
      }
    },
    "请提供举报或处置编号、收到的处理结果，以及希望复核的事实和理由。": {
      "comment": "Compliance.swift:31",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请提供举报或处置编号、收到的处理结果，以及希望复核的事实和理由。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請提供舉報或處置編號、收到的處理結果，以及希望復核的事實和理由。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provide the report or decision ID, the outcome you received, and the facts and reasons you would like reviewed."
          }
        }
      }
    },
    "南图 · %@\n\n%@\n\n%@\n\n请勿发送密码、验证码、无关完整证件或他人的敏感信息。": {
      "comment": "Compliance.swift:35 Format arguments retain their types and order; %@ is text, %lld is an integer. Literal %% is a percent sign.",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "南图 · %@\n\n%@\n\n%@\n\n请勿发送密码、验证码、无关完整证件或他人的敏感信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "南圖 · %@\n\n%@\n\n%@\n\n請勿傳送密碼、驗證碼、無關完整證件或他人的敏感資訊。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NonTo · %@\n\n%@\n\n%@\n\nDo not send passwords, verification codes, unrelated full identity documents or other people’s sensitive information."
          }
        }
      }
    },
    "南图 · %@": {
      "comment": "Compliance.swift:60 Format arguments retain their types and order; %@ is text, %lld is an integer. Literal %% is a percent sign.",
