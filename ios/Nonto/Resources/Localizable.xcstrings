            "state": "translated",
            "value": "照片、影片與通知"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos, videos and notifications"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos, vidéos et notifications"
          }
        },
        "ru": {
          "stringUnit": {
