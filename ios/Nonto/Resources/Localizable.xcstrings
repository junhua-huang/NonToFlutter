    "了解账号、内容和推送信息如何处理，以及如何管理权限和申请删除。": {
      "comment": "Compliance.swift:13",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解账号、内容和推送信息如何处理，以及如何管理权限和申请删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瞭解帳號、內容和推送資訊如何處理，以及如何管理權限和申請刪除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn how account, content and notification information is handled, and how to manage permissions and request deletion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez comment les informations de compte, de contenu et de notification sont traitées, et comment gérer les autorisations et demander la suppression."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте, как обрабатывается информация об учетной записи, контенте и уведомлениях, а также как управлять разрешениями и запрашивать удаление."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprenda cómo se maneja la información de la cuenta, el contenido y las notificaciones, y cómo administrar los permisos y solicitar la eliminación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント、コンテンツ、通知情報がどのように処理されるか、権限を管理して削除をリクエストする方法について説明します。"
          }
        }
      }
    },
    "了解账号使用、内容权利、服务边界，以及举报和申诉方式。": {
      "comment": "Compliance.swift:14",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解账号使用、内容权利、服务边界，以及举报和申诉方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瞭解帳號使用、內容權利、服務邊界，以及舉報和申訴方式。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn about account use, content rights, service limitations, reports and appeals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprenez-en davantage sur l'utilisation du compte, les droits sur le contenu, les limitations du service, les rapports et les appels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте об использовании учетной записи, правах на контент, ограничениях услуг, отчетах и ​​апелляциях."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenga información sobre el uso de la cuenta, derechos de contenido, limitaciones del servicio, informes y apelaciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントの使用、コンテンツの権利、サービスの制限、レポートと異議申し立てについて学びます。"
          }
        }
      }
    },
    "尊重他人的隐私与交往意愿；发现骚扰、侵权或违法内容时，可以举报或屏蔽。": {
      "comment": "Compliance.swift:15",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尊重他人的隐私与交往意愿；发现骚扰、侵权或违法内容时，可以举报或屏蔽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尊重他人的隱私與交往意願；發現騷擾、侵權或違法內容時，可以舉報或封鎖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Respect others’ privacy and boundaries. Report or block harassment, infringement or illegal content."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Respectez la vie privée et les limites des autres. Signalez ou bloquez le harcèlement, la violation ou le contenu illégal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уважайте частную жизнь и границы других. Сообщите о преследовании, нарушении прав или незаконном контенте или заблокируйте его."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Respete la privacidad y los límites de los demás. Informar o bloquear acoso, infracción o contenido ilegal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他人のプライバシーと境界を尊重します。嫌がらせ、侵害、または違法なコンテンツを報告またはブロックします。"
          }
        }
      }
    },
    "使用反馈": {
