    "相关账号、内容编号、必要访问记录和你提交的说明，用于账号安全、问题排查、举报与权利请求处理。": {
      "comment": "PrivacyViews.swift:77",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相关账号、内容编号、必要访问记录和你提交的说明，用于账号安全、问题排查、举报与权利请求处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相關帳號、內容編號、必要訪問記錄和你提交的說明，用於帳號安全、問題排查、舉報與權利請求處理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relevant accounts, content IDs, necessary access logs and details you submit are used for account security, troubleshooting, reports and data rights requests."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes pertinents, les identifiants de contenu, les journaux d'accès nécessaires et les détails que vous soumettez sont utilisés pour la sécurité du compte, le dépannage, les rapports et les demandes de droits sur les données."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соответствующие учетные записи, идентификаторы контента, необходимые журналы доступа и отправляемые вами данные используются для обеспечения безопасности учетной записи, устранения неполадок, отчетов и запросов прав на данные."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cuentas relevantes, los ID de contenido, los registros de acceso necesarios y los detalles que usted envía se utilizan para la seguridad de la cuenta, la resolución de problemas, los informes y las solicitudes de derechos de datos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連するアカウント、コンテンツ ID、必要なアクセス ログ、および送信した詳細は、アカウントのセキュリティ、トラブルシューティング、レポート、データ権利の要求に使用されます。"
          }
        }
      }
    },
    "角色认证材料请遮盖无关的身份证、银行卡、住址及他人敏感信息。": {
      "comment": "PrivacyViews.swift:78",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "角色认证材料请遮盖无关的身份证、银行卡、住址及他人敏感信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "角色認證材料請遮蓋無關的身份證、銀行卡、住址及他人敏感資訊。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redact unrelated identity documents, bank cards, addresses and other people’s sensitive information from verification materials."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez les documents d’identité, les cartes bancaires, les adresses et les informations sensibles d’autres personnes sans rapport avec les documents de vérification."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите из материалов проверки несвязанные документы, удостоверяющие личность, банковские карты, адреса и конфиденциальную информацию других людей."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimine documentos de identidad, tarjetas bancarias, direcciones e información confidencial de otras personas no relacionados de los materiales de verificación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無関係な身分証明書、銀行カード、住所、その他の人の機密情報を検証資料から編集します。"
          }
        }
      }
    },
