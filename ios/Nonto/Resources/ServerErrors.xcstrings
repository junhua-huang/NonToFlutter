        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This email address is already registered."
          }
        }
      }
    },
    "验证码无效或已过期": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证码无效或已过期"
          }
