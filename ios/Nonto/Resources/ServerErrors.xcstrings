{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "头像/封面 URL 必须使用 https:// 协议": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头像/封面 URL 必须使用 https:// 协议"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頭像/封面 URL 必須使用 https:// 協議"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avatar and cover links must use https://."
          }
        }
      }
    },
    "头像/封面 URL 域名不在允许列表内": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头像/封面 URL 域名不在允许列表内"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頭像/封面 URL 域名不在允許列表內"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This avatar or cover domain is not allowed."
          }
        }
      }
    },
    "目前仅支持 QQ 邮箱注册": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前仅支持 QQ 邮箱注册"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前僅支持 QQ 郵箱註冊"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration currently supports QQ email addresses only."
          }
        }
      }
    },
    "该邮箱已被注册": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该邮箱已被注册"
