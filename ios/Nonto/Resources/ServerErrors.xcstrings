        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證碼無效或已過期"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification code is invalid or has expired."
          }
        }
      }
    },
    "登录失败次数过多，请通过邮箱验证码继续登录": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录失败次数过多，请通过邮箱验证码继续登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登錄失敗次數過多，請通過郵箱驗證碼繼續登錄"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many failed sign-in attempts. Continue using an email verification code."
          }
        }
      }
    },
    "登录状态已失效，请重新登录": {
      "extractionState": "manual",
      "localizations": {
