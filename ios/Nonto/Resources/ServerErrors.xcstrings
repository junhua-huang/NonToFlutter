{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "头像/封面 URL 必须使用 https:// 协议": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头像/封面 URL 必须使用 https:// 协议"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頭像/封面 URL 必須使用 https:// 協議"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avatar and cover links must use https://."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens d'avatar et de couverture doivent utiliser https://."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки на аватар и обложку должны использовать https://.."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de avatar y portada deben usar https://."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アバターとカバーのリンクは https://. を使用する必要があります"
          }
        }
      }
    },
    "头像/封面 URL 域名不在允许列表内": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头像/封面 URL 域名不在允许列表内"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頭像/封面 URL 域名不在允許列表內"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This avatar or cover domain is not allowed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet avatar ou domaine de couverture n'est pas autorisé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот аватар или домен обложки запрещен."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este avatar o dominio de portada no está permitido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアバターまたはカバー ドメインは許可されていません。"
          }
        }
      }
    },
    "目前仅支持 QQ 邮箱注册": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前仅支持 QQ 邮箱注册"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前僅支持 QQ 郵箱註冊"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registration currently supports QQ email addresses only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inscription prend actuellement en charge uniquement les adresses e-mail QQ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настоящее время регистрация поддерживает только адреса электронной почты QQ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualmente, el registro solo admite direcciones de correo electrónico QQ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、登録では QQ 電子メール アドレスのみがサポートされています。"
          }
        }
      }
    },
    "该邮箱已被注册": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该邮箱已被注册"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該郵箱已被註冊"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This email address is already registered."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse email est déjà enregistrée."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот адрес электронной почты уже зарегистрирован."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección de correo electrónico ya está registrada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールアドレスはすでに登録されています。"
          }
        }
      }
    },
    "验证码无效或已过期": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证码无效或已过期"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證碼無效或已過期"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verification code is invalid or has expired."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code de vérification n'est pas valide ou a expiré."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код подтверждения недействителен или срок его действия истек."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código de verificación no es válido o ha caducado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認コードが無効であるか、有効期限が切れています。"
          }
        }
      }
    },
    "登录失败次数过多，请通过邮箱验证码继续登录": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录失败次数过多，请通过邮箱验证码继续登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登錄失敗次數過多，請通過郵箱驗證碼繼續登錄"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many failed sign-in attempts. Continue using an email verification code."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives de connexion ont échoué. Continuez à utiliser un code de vérification par e-mail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много неудачных попыток входа. Продолжайте использовать код подтверждения электронной почты."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos fallidos de inicio de sesión. Continúe usando un código de verificación por correo electrónico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗したサインイン試行が多すぎます。引き続き電子メール確認コードを使用してください。"
          }
        }
      }
    },
    "登录状态已失效，请重新登录": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录状态已失效，请重新登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登錄狀態已失效，請重新登錄"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Sign in again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session a expiré. Connectez-vous à nouveau."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок вашей сессии истек. Войдите снова."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión ha caducado. Inicia sesión nuevamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの有効期限が切れました。再度サインインします。"
          }
        }
      }
    },
    "新密码至少 8 位": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新密码至少 8 位"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新密碼至少 8 位"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your new password must have at least 8 characters."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nouveau mot de passe doit comporter au moins 8 caractères."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш новый пароль должен содержать не менее 8 символов."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su nueva contraseña debe tener al menos 8 caracteres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいパスワードは 8 文字以上である必要があります。"
          }
        }
      }
    },
    "密码重设失败，请稍后重试": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
